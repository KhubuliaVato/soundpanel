<Window x:Class="SoundPanel.FifuHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoundPanel.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <Border Margin="14" Padding="14,10,22,10" MinWidth="230" CornerRadius="22"
            Background="#F2161330" BorderBrush="#66A78BFA" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Viewbox Width="58" Height="58">
                <ctl:RobotFace x:Name="Face" Width="96" Height="98" />
            </Viewbox>
            <TextBlock x:Name="Msg" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="240"
                       FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>