<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== COLORS & BRUSHES ===================== -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource AccentColorA}" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBrushH" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource AccentColorA}" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBrushV" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource AccentColorA}" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HotBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5CA8" Offset="0" />
        <GradientStop Color="{DynamicResource AccentColorA}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#090912" Offset="0" />
        <GradientStop Color="#120E26" Offset="0.55" />
        <GradientStop Color="#08111F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2FA" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9A9AB8" />
    <SolidColorBrush x:Key="TextMuted" Color="#62627E" />

    <!-- ===================== ICONS (24x24 grid) ===================== -->
    <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPause">M7,5 H11 V19 H7 Z M13,5 H17 V19 H13 Z</StreamGeometry>
    <StreamGeometry x:Key="IconNext">M6,5 L15,12 L6,19 Z M17,5 H19.5 V19 H17 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPrev">M18,5 L9,12 L18,19 Z M7,5 H4.5 V19 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M3,6 H10 L12,8.5 H21 V19 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconNote">M10,3 V14.2 A3,3 0 1 0 12,17 V7 H17 V3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconLibrary">M4,5 H8 V19 H4 Z M10,5 H14 V19 H10 Z M16,6 L20,5 L21.5,18.5 L17.5,19.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconVolume">M3,9 H7 L12,4.5 V19.5 L7,15 H3 Z M14.5,8.5 A5,5 0 0 1 14.5,15.5 L15.6,16.6 A6.6,6.6 0 0 0 15.6,7.4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M5,5 L19,19 M19,5 L5,19</StreamGeometry>
    <StreamGeometry x:Key="IconMinimize">M5,12 H19</StreamGeometry>
    <StreamGeometry x:Key="IconMaximize">M6,6 H18 V18 H6 Z</StreamGeometry>

    <!-- ===================== ICON BUTTON (ghost) ===================== -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <SolidColorBrush x:Name="Bg" Color="#00FFFFFF" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#22FFFFFF" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#00FFFFFF" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" DecelerationRatio="1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="12">
                        <Border.Background>
                            <SolidColorBrush x:Name="Bg" Color="#00E5484D" />
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#CCE5484D" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#00E5484D" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ROUND PLAY BUTTON ===================== -->
    <Style x:Key="PlayButton" TargetType="Button">
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="58" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{DynamicResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="Glow" Color="{DynamicResource AccentColorA}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.2" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.2" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="32" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.93" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.93" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ACCENT (gradient pill) BUTTON ===================== -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="14" Background="{DynamicResource AccentBrush}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" Color="{DynamicResource AccentColorA}" BlurRadius="14" ShadowDepth="0" Opacity="0.4" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.18" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.18" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="28" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.28" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.28" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== GHOST (outlined pill) BUTTON ===================== -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="14" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <Border.BorderBrush>
                            <SolidColorBrush x:Name="Br" Color="#26FFFFFF" />
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush x:Name="Bg" Color="#0DFFFFFF" />
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#22FFFFFF" Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="Br" Storyboard.TargetProperty="Color" 	To="#55FFFFFF" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#0DFFFFFF" Duration="0:0:0.25" />
                                        <ColorAnimation Storyboard.TargetName="Br" Storyboard.TargetProperty="Color" To="#26FFFFFF" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SCROLLBAR ===================== -->
    <Style x:Key="ScrollEmptyRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollEmptyRepeat}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Margin="2,0" CornerRadius="3">
                                                <Border.Background>
                                                    <SolidColorBrush x:Name="Tb" Color="#33FFFFFF" />
                                                </Border.Background>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Tb" Storyboard.TargetProperty="Color" To="#66FFFFFF" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Tb" Storyboard.TargetProperty="Color" To="#33FFFFFF" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollEmptyRepeat}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== FLAT LISTBOX ===================== -->
    <Style x:Key="FlatListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== GROUP (SIDEBAR) ITEM ===================== -->
    <Style x:Key="GroupItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="RootSc" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border CornerRadius="14" Padding="12,10" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush x:Name="Bg" Color="#00FFFFFF" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="Br" Color="#00FFFFFF" />
                            </Border.BorderBrush>
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Bar" Width="3" Height="22" CornerRadius="2" HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="DropOverlay" CornerRadius="14" BorderThickness="1.5" IsHitTestVisible="False"
                                	Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#14FFFFFF" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#00FFFFFF" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#22FFFFFF" Duration="0:0:0.25" />
                                        <ColorAnimation Storyboard.TargetName="Br" Storyboard.TargetProperty="Color" To="#33FFFFFF" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3" DecelerationRatio="1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#00FFFFFF" Duration="0:0:0.25" />
                                        <ColorAnimation Storyboard.TargetName="Br" Storyboard.TargetProperty="Color" To="#00FFFFFF" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DropOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="RootSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="RootSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" DecelerationRatio="1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DropOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="RootSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="RootSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" DecelerationRatio="1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TRACK ITEM ===================== -->
    <Style x:Key="TrackItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Slide">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SlideTr" Y="0" />
                        </Border.RenderTransform>
                        <Border CornerRadius="14" Padding="12,9" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush x:Name="Bg" Color="#00FFFFFF" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="Br" Color="#00FFFFFF" />
                            </Border.BorderBrush>
                            <ContentPresenter />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                                    <DoubleAnimation Storyboard.TargetName="SlideTr" Storyboard.TargetProperty="Y" From="14" To="0" Duration="0:0:0.35" DecelerationRatio="1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#14FFFFFF" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#00FFFFFF" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#1EFFFFFF" Duration="0:0:0.22" />
                                        <ColorAnimation Storyboard.TargetName="Br" Storyboard.TargetProperty="Color" 	To="#2CFFFFFF" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#00FFFFFF" Duration="0:0:0.25" />
                                        <ColorAnimation Storyboard.TargetName="Br" Storyboard.TargetProperty="Color" To="#00FFFFFF" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SLIDER ===================== -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="18" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrushH}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="18" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="White" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="0.85" ScaleY="0.85" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentColorA}" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.3" Duration="0:0:0.15" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.15" DecelerationRatio="1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlowSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Height="18">
                        <Border Height="4" CornerRadius="2" Background="#22FFFFFF" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TEXTBOX (dialogs) ===================== -->
    <Style x:Key="DialogTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="SelectionBrush" 	Value="{DynamicResource AccentBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="14" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <SolidColorBrush x:Name="Bg" Color="#14FFFFFF" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush x:Name="Br" Color="#26FFFFFF" />
                        </Border.BorderBrush>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Br" Storyboard.TargetProperty="Color" 	To="#88FFFFFF" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#1CFFFFFF" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Br" Storyboard.TargetProperty="Color" To="#26FFFFFF" Duration="0:0:0.25" />
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Color" To="#14FFFFFF" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SHUFFLE / REPEAT ICONS ===================== -->
    <StreamGeometry x:Key="IconShuffle">M16,3 L21,3 L21,8 M4,20 L21,3 M21,16 L21,21 L16,21 M15,15 L21,21 M4,4 L9,9</StreamGeometry>
    <StreamGeometry x:Key="IconRepeat">M17,1 L21,5 L17,9 M3,11 V9 A4,4 0 0 1 7,5 H21 M7,23 L3,19 L7,15 M21,13 V15 A4,4 0 0 1 17,19 H3</StreamGeometry>

    <!-- ===================== TOGGLE ICON BUTTON ===================== -->
    <Style x:Key="ToggleIconButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Hover" CornerRadius="12" Background="#1AFFFFFF" Opacity="0" />
                        <Border x:Name="Active" CornerRadius="12" BorderThickness="1" 	BorderBrush="{DynamicResource AccentBorderBrush}"
                                Background="{DynamicResource AccentSoftBrush}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="Dot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Bottom" Margin="0,0,0,4" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" DecelerationRatio="1" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" DecelerationRatio="1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
