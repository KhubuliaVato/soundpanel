<UserControl x:Class="SoundPanel.Controls.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:ctl="clr-namespace:SoundPanel.Controls"
             Visibility="Collapsed">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="2,22,0,10" />
        </Style>

        <Style x:Key="PlainListBox" TargetType="ListBox">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- animated switch -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border CornerRadius="13" Background="#26FFFFFF" />
                            <Border x:Name="On" CornerRadius="13" Background="{DynamicResource AccentBrushH}" Opacity="0" />
                            <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobTr" X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetName="KnobTr" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetName="KnobTr" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- round color swatch -->
        <Style x:Key="SwatchItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="44" Height="44" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="5" Fill="{Binding Preview}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="DotSc" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="DotSc" Storyboard.TargetProperty="ScaleX" To="0.86" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="DotSc" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="DotSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="DotSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- audio device row -->
        <Style x:Key="DeviceItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="12" Background="#14FFFFFF" Opacity="0" />
                            <Border x:Name="Sel" CornerRadius="12" BorderThickness="1" Opacity="0"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" />
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Radio" Width="10" Height="10" Fill="Transparent"
                                         Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" />
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Radio" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Radio" Property="Stroke" Value="Transparent" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    
   
    <Border x:Name="Surface" CornerRadius="24" Opacity="0"
            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SurfaceTr" Y="14" />
        </Border.RenderTransform>

        <Border.Resources>
            <Style x:Key="CatItem" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="12" Padding="14,10" Margin="0,0,0,4"
                                    BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="SemiBold" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingRow" TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="#14FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Border.Resources>

        <Grid Margin="26,22,16,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,20">
                <TextBlock FontSize="30" FontWeight="Bold" Text="პარამეტრები"
                           Foreground="{DynamicResource AccentBrushH}" />
                <TextBlock Margin="2,2,0,0" FontSize="13" Foreground="{StaticResource TextSecondary}"
                           Text="მოარგე პროგრამა შენს გემოვნებას" />
            </StackPanel>

            <!-- categories -->
            <StackPanel Grid.Row="1">
                <RadioButton GroupName="cat" Tag="General" IsChecked="True" Style="{StaticResource CatItem}"
                             Content="ზოგადი" Checked="Cat_Checked" />
                <RadioButton GroupName="cat" Tag="Look" Style="{StaticResource CatItem}"
                             Content="გარეგნობა" Checked="Cat_Checked" />
                <RadioButton x:Name="CatFifu" GroupName="cat" Tag="Fifu" Style="{StaticResource CatItem}"
                             Content="Fifu" Checked="Cat_Checked" />
                <RadioButton GroupName="cat" Tag="Audio" Style="{StaticResource CatItem}"
                             Content="აუდიო" Checked="Cat_Checked" />
                <RadioButton GroupName="cat" Tag="Keys" Style="{StaticResource CatItem}"
                             Content="ღილაკები" Checked="Cat_Checked" />
                <RadioButton GroupName="cat" Tag="About" Style="{StaticResource CatItem}"
                             Content="შესახებ" Checked="Cat_Checked" />
            </StackPanel>

            <!-- sections -->
            <ScrollViewer x:Name="SectionScroll" Grid.Row="1" Grid.Column="2"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="Sections" Margin="0,0,10,0">

                    <!-- GENERAL -->
                    <StackPanel x:Name="SecGeneral">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,10" Text="ბიბლიოთეკა" />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="მუსიკის საქაღალდე" />
                                    <TextBlock Margin="0,3,14,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                                               Text="{Binding RootFolderDisplay}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RootFolderDisplay}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="შეცვლა"
                                        Click="ChooseFolder_Click" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,18,0,10" Text="ფანჯარა" />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="მთელი ეკრანი" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="F11 — ჩართვა, Esc — გამოსვლა" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsFullscreen, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="ყოველთვის წინა პლანზე" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="სხვა ფანჯრების ზემოთ დარჩება" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="რობოტი ჩაკეცვისას" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="პატარა ფლეიერი ეკრანის კუთხეში" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding MiniOnMinimize, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,18,0,10" Text="სისტემა" />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="ჩართვა Windows-თან ერთად" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="კომპიუტერის ჩართვისას თავისით გაიხსნება" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- LOOK -->
                    <StackPanel x:Name="SecLook" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,10" Text="პროგრამის ფერი" />
                        <Border Style="{StaticResource SettingRow}">
                            <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding AccentThemes}"
                                     SelectedValuePath="Id" SelectedValue="{Binding AccentThemeId, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource SwatchItem}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Border>
                    </StackPanel>

                    <!-- FIFU (voice + sleep timer are built in MainWindow and placed into FifuHost) -->
                    <StackPanel x:Name="SecFifu" Visibility="Collapsed">
                        <ContentControl x:Name="FifuHost" IsTabStop="False" HorizontalContentAlignment="Stretch" />

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,18,0,10" Text="რობოტის ფერი" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="100" Height="100" CornerRadius="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                    <ctl:RobotFace Margin="2" Cursor="Arrow"
                                                   IsPlaying="{Binding IsPlaying, Mode=OneWay}"
                                                   Peaks="{Binding Peaks, Mode=OneWay}"
                                                   Position="{Binding PositionSeconds, Mode=OneWay}"
                                                   Duration="{Binding DurationSeconds, Mode=OneWay}" />
                                </Border>
                                <ListBox Grid.Column="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding RobotThemes}"
                                         SelectedValuePath="Id" SelectedValue="{Binding RobotThemeId, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource SwatchItem}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- AUDIO -->
                    <StackPanel x:Name="SecAudio" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,10" Text="ხმის გამოსვლა" />
                        <Border Style="{StaticResource SettingRow}" Padding="10,8">
                            <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding OutputDevices}"
                                     SelectedValuePath="Key" SelectedValue="{Binding OutputDeviceKey, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource DeviceItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>

                    <!-- KEYS -->
                    <StackPanel x:Name="SecKeys" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,10" Text="გლობალური კლავიშები" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="სწრაფი ძებნა" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="მუშაობს ჩაკეცილ პროგრამაზეც" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="HotkeyButton" MinWidth="118" Style="{StaticResource GhostButton}"
                                            Content="{Binding QuickSearchHotkeyDisplay}"
                                            Click="HotkeyButton_Click"
                                            PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                            LostKeyboardFocus="HotkeyButton_LostFocus" />
                                    <Button Margin="6,0,0,0" Width="34" Style="{StaticResource GhostButton}"
                                            Content="✕" ToolTip="გამორთვა" Click="HotkeyClear_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="HotkeyHint" Margin="4,0,0,8" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentTextBrush}" Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,18,0,12" Text="მალსახმობები პროგრამაში" />

                        <Grid Margin="4,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,3" Background="#1AFFFFFF">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="Ctrl + F" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" Text="ძებნა ბიბლიოთეკაში" />
                        </Grid>
                        <Grid Margin="4,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,3" Background="#1AFFFFFF">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="Space" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" Text="დაკვრა / პაუზა" />
                        </Grid>
                        <Grid Margin="4,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,3" Background="#1AFFFFFF">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="Ctrl + M" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" Text="ხმოვანი ბრძანება (Fifu)" />
                        </Grid>
                        <Grid Margin="4,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,3" Background="#1AFFFFFF">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="F11" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" Text="მთელი ეკრანი" />
                        </Grid>
                        <Grid Margin="4,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,3" Background="#1AFFFFFF">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="Esc" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" Text="გვერდიდან ბიბლიოთეკაში დაბრუნება" />
                        </Grid>
                                            </StackPanel>
                   
                    <!-- ABOUT (keep this section LAST: Cat_Checked uses it as the loaded marker) -->
                    <StackPanel x:Name="SecAbout" Visibility="Collapsed">
                        <Border Margin="0,0,0,16" CornerRadius="16" Padding="16" Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                               Text="yt-dlp-ის განახლება" />
                                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                                               Text="თუ რომელიმე ბმული აღარ ჩამოიტვირთება, ჯერ ეს სცადე. YouTube ხშირად იცვლება და ახალი ვერსია ამას აგვარებს." />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Padding="18,0" Height="40"
                                        Content="განახლება" Click="UpdateTools_Click" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" Padding="22,20">
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Text="1Flow SoundPanel" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextMuted}">
                                    <Run Text="ვერსია " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,18,0,10" Text="პარამეტრების განულება" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" Text="ყველა პარამეტრი დაუბრუნდება საწყის მნიშვნელობას" />
                                <Button Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource GhostButton}"
                                        Content="განულება" Click="Reset_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>