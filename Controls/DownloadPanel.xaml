<UserControl x:Class="SoundPanel.Controls.DownloadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="2,20,0,10" />
        </Style>

        <!-- compact dark text field -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Padding="0"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Stretch" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- thin glowing progress bar -->
        <Style x:Key="GlowProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="#22FFFFFF" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{DynamicResource AccentBrushH}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- pill chip -->
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12" Padding="14,8" BorderThickness="1"
                                BorderBrush="#22FFFFFF" Background="#0DFFFFFF">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <!-- chip list (wrap panel of chips) -->
        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- component (target folder) row -->
        <Style x:Key="TargetItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12" Padding="12,9" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Radio" Width="10" Height="10" Fill="Transparent"
                                         Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" />
                                <TextBlock Grid.Column="1" Margin="10,0,8,0" FontSize="13" FontWeight="SemiBold"
                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource TextMuted}"
                                           Text="{Binding Count}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter TargetName="Radio" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Radio" Property="Stroke" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- animated switch -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border CornerRadius="13" Background="#26FFFFFF" />
                            <Border x:Name="On" CornerRadius="13" Background="{DynamicResource AccentBrushH}" Opacity="0" />
                            <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobTr" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetName="KnobTr" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetName="KnobTr" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- check box row for playlist entries -->
        <Style x:Key="EntryCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" CornerRadius="10" Padding="8,7" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5"
                                        BorderBrush="#55FFFFFF" Background="Transparent" VerticalAlignment="Center">
                                    <Path x:Name="Tick" Data="M5,10.5 L8.5,14 L15,7" Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stretch="Uniform" Margin="3" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one queue entry -->
        <DataTemplate x:Key="DownloadItemTemplate">
            <Border CornerRadius="16" Padding="14,12" Margin="0,0,0,8" Background="#0FFFFFFF"
                    BorderBrush="#1AFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                   Foreground="{StaticResource TextPrimary}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Detail}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" FontSize="11"
                                       Foreground="{StaticResource TextMuted}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource GlowProgress}" Margin="0,8,0,0"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="#FBBF24"
                                   Text="პროგრესი დიდი ხანია არ მოძრაობს. სცადე პაუზა და გაგრძელება"
                                   Visibility="{Binding IsStalled, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Error}" ToolTip="{Binding ErrorRaw}" Margin="0,6,0,0" FontSize="11"
                                   TextWrapping="Wrap" Foreground="#F87171"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource TextMuted}"
                                   Text="{Binding GroupName, StringFormat=→ {0}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" ToolTip="დაკვრა"
                                Click="ItemPlay_Click"
                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                            <Path Data="M8,5 L19,12 L8,19 Z" Fill="{StaticResource TextSecondary}" Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" ToolTip="საქაღალდეში ჩვენება"
                                Click="ItemFolder_Click"
                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                            <Path Data="M3,7 V18 H21 V9 H12 L10,6 H3 Z" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" ToolTip="სხვა კომპონენტში გადატანა"
                                Click="ItemMove_Click"
                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                            <Path Data="M4,12 H18 M13,7 L18,12 L13,17" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" ToolTip="პაუზა"
                                Click="ItemPause_Click"
                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}">
                            <Path Data="M8,6 V18 M16,6 V18" Stroke="{StaticResource TextSecondary}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" ToolTip="გაგრძელება"
                                Click="ItemResume_Click"
                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}">
                            <Path Data="M8,5 L19,12 L8,19 Z" Fill="{DynamicResource AccentBrushH}" Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" ToolTip="გაუქმება"
                                Click="ItemCancel_Click"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <Path Data="M7,7 H17 V17 H7 Z" Fill="{StaticResource TextSecondary}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" ToolTip="თავიდან ცდა"
                                Click="ItemRetry_Click"
                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
                            <Path Data="M20,12 A8,8 0 1 1 17.6,6.3 M20,4 V9 H15" Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" ToolTip="სიიდან ამოღება"
                                Click="ItemRemove_Click"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="#4ADE80" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="#F87171" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused">
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="#FBBF24" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    
   
    <Grid>
        <Border x:Name="Surface" CornerRadius="24" Opacity="0"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SurfaceTr" Y="14" />
            </Border.RenderTransform>

            <Grid Margin="26,22,16,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- ============================ LEFT: search, preview, downloads ============================ -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock FontSize="30" FontWeight="Bold" Text="ჩამოტვირთვა"
                                   Foreground="{DynamicResource AccentBrushH}" />
                        <TextBlock Margin="2,2,0,0" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                   Text="ბმულიდან მუსიკა პირდაპირ კომპონენტში ჩაიწერება" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">

                            <!-- no main folder warning -->
                            <Border Margin="0,10,0,0" CornerRadius="12" Padding="12,9" Background="#26F59E0B"
                                    BorderBrush="#66F59E0B" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRoot}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="12" Foreground="#FCD34D" TextWrapping="Wrap"
                                           Text="ჯერ აირჩიე მუსიკის საქაღალდე პარამეტრებში." />
                            </Border>

                            <!-- link / search input -->
                            <Grid Margin="0,8,0,0">
                                <TextBox x:Name="UrlBox" Style="{StaticResource FieldBox}" Padding="8,0"
                                         Height="46" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                         Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="UrlBox_PreviewKeyDown" />
                                <TextBlock IsHitTestVisible="False" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                                           Text="ჩასვი ბმული ან ჩაწერე სიმღერის სახელი">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource GhostButton}" Content="ჩასმა" Click="Paste_Click" />
                                <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource AccentButton}"
                                        Content="{Binding AddButtonText}" Click="Add_Click" ToolTip="Ctrl + Enter" />
                            </Grid>

                            <!-- first-run tools install -->
                            <Border Margin="0,12,0,0" CornerRadius="14" Padding="14,12" Background="#14FFFFFF"
                                    BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstallingTools}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                               Text="საჭირო პროგრამები მზადდება (ერთხელ)" />
                                    <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               Text="{Binding ToolsStatus}" TextWrapping="Wrap" />
                                    <ProgressBar Style="{StaticResource GlowProgress}" Value="{Binding ToolsProgress, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!-- analyzing -->
                            <TextBlock Margin="2,12,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       Text="ბმული მოწმდება…"
                                       Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseStory">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.7" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PulseStory" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Margin="2,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#F87171"
                                       Text="{Binding AnalyzeError}"
                                       Visibility="{Binding HasAnalyzeError, Converter={StaticResource BoolToVis}}" />

                            <!-- search by name -->
                            <TextBlock Margin="2,12,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       Text="ვეძებ…"
                                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="2,12,0,0" FontSize="12" Foreground="#F87171" TextWrapping="Wrap"
                                       Text="{Binding SearchError}"
                                       Visibility="{Binding HasSearchError, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,8" Text="ნაპოვნია YouTube-ზე" />
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" CornerRadius="12" Padding="8" Cursor="Hand"
                                                    BorderBrush="#14FFFFFF" BorderThickness="1"
                                                    ToolTip="ბმულის არჩევა (გადახედვა, სახელი, მოჭრა)"
                                                    MouseLeftButtonUp="SearchRow_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#0DFFFFFF" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#1AFFFFFF" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="72" Height="40" VerticalAlignment="Center">
                                                        <Border CornerRadius="8" Background="#14FFFFFF" />
                                                        <Border CornerRadius="8">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="უკვე გაქვს" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="#FBBF24" Margin="0,0,8,0"
                                                                       ToolTip="{Binding DuplicateName}"
                                                                       Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Width="30" Height="30" Style="{StaticResource IconButton}"
                                                            ToolTip="პირდაპირ რიგში დამატება" Click="SearchAdd_Click">
                                                        <Path Data="M12,5 V19 M5,12 H19" Stroke="{DynamicResource AccentBrushH}" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,2,0,0" Style="{StaticResource GhostButton}"
                                        Content="მეტის ჩვენება" Click="LoadMore_Click"
                                        Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Margin="2,8,0,0" FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" Text="ვეძებ…"
                                           Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- preview card -->
                            <Border Margin="0,12,0,0" CornerRadius="16" Padding="12" Background="#0FFFFFFF"
                                    BorderBrush="#1AFFFFFF" BorderThickness="1"
                                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="116" Height="66" VerticalAlignment="Top">
                                            <Border CornerRadius="10" Background="#14FFFFFF" />
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding PreviewThumb}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Preview.Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Preview.Title}"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Preview.Subtitle}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- single video: file name + trim -->
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding ShowSingle, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <TextBox Style="{StaticResource FieldBox}" x:Name="NameBox"
                                                     Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock IsHitTestVisible="False" Margin="13,0,13,0" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" Text="ფაილის სახელი (არასავალდებულო)">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <TextBlock Margin="2,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="#FBBF24"
                                                   Text="{Binding DuplicateText}"
                                                   Visibility="{Binding HasDuplicate, Converter={StaticResource BoolToVis}}" />

                                        <Grid Margin="0,12,0,0" Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="მხოლოდ ნაწილის ჩამოტვირთვა" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="მაგ. 1:20 — 2:05" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                                          IsChecked="{Binding TrimEnabled, Mode=TwoWay}" />
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrimEnabled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Margin="2,0,0,4" FontSize="11" Foreground="{StaticResource TextMuted}" Text="დასაწყისი" />
                                                <TextBox Style="{StaticResource FieldBox}" ToolTip="0:00"
                                                         Text="{Binding TrimStart, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="2,0,0,4" FontSize="11" Foreground="{StaticResource TextMuted}" Text="დასასრული (ცარიელი — ბოლომდე)" />
                                                <TextBox Style="{StaticResource FieldBox}" ToolTip="ბოლომდე"
                                                         Text="{Binding TrimEnd, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- playlist: pick entries -->
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding ShowPlaylistList, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                       Text="{Binding SelectedCountText}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostButton}" Padding="12,5" FontSize="11"
                                                        Content="ყველა" Click="SelectAll_Click" />
                                                <Button Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="12,5" FontSize="11"
                                                        Content="არცერთი" Click="SelectNone_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <ScrollViewer Margin="0,8,0,0" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Preview.Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource EntryCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Title}" Foreground="{StaticResource TextPrimary}" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                                    <TextBlock Text="უკვე გაქვს" FontSize="10" FontWeight="SemiBold" Foreground="#FBBF24"
                                                                               Margin="0,0,8,0" VerticalAlignment="Center"
                                                                               ToolTip="{Binding DuplicateName}"
                                                                               Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}" />
                                                                    <TextBlock Text="{Binding DurationText}" FontSize="11"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- downloads (visible only when there is something) -->
                            <StackPanel Margin="0,22,0,0"
                                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}" Text="{Binding QueueTitle}" />
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="12,6" FontSize="11"
                                            Content="გასუფთავება" Click="ClearFinished_Click" />
                                </Grid>

                                <Grid Margin="0,10,0,10">
                                    <TextBox x:Name="QueueBox" Style="{StaticResource FieldBox}" Padding="13,9"
                                             Text="{Binding QueueSearch, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock IsHitTestVisible="False" Margin="14,0,14,0" VerticalAlignment="Center" FontSize="13"
                                               Foreground="{StaticResource TextMuted}" Text="ძებნა ჩამოტვირთვებსა და ისტორიაში…">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=QueueBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource DownloadItemTemplate}" />

                                <TextBlock Margin="0,16,0,8" HorizontalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource TextMuted}" Text="ვერაფერი მოიძებნა"
                                           Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Border Height="8" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                
                <!-- divider -->
                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Margin="0,6,0,6" Background="#14FFFFFF" />

                <!-- ============================ RIGHT: settings ============================ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="0,4,0,6" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}" Text="პარამეტრები" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">

                            <!-- format -->
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="2,8,0,10" Text="ფორმატი" />
                            <ListBox Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding Formats}" DisplayMemberPath="Name"
                                     SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />

                            <!-- quality (lossy formats only) -->
                            <StackPanel Visibility="{Binding ShowQuality, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="2,14,0,10" Text="ხარისხი" />
                                <ListBox Style="{StaticResource ChipList}"
                                         ItemsSource="{Binding Qualities}" DisplayMemberPath="Name"
                                         SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- target component -->
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="2,14,0,10" Text="ჩასაწერი კომპონენტი" />
                            <ListBox Style="{StaticResource FlatListBox}" MaxHeight="170"
                                     ItemsSource="{Binding Groups}"
                                     SelectedValuePath="FolderPath"
                                     SelectedValue="{Binding TargetFolder, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource TargetItem}" />

                            <!-- options -->
                            <TextBlock Style="{StaticResource SectionTitle}" Text="პარამეტრები" />
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="პლეილისტის რეჟიმი" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="პლეილისტის ბმულზე ამოირჩევ ვიდეოებს" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding Playlist, Mode=TwoWay}" />
                            </Grid>
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="სურათი და ინფორმაცია" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="ქავერი, სახელი, შემსრულებელი ფაილში" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding EmbedThumbnail, Mode=TwoWay}" />
                            </Grid>
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="სახელის გასუფთავება" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="„Artist - Title“, ზედმეტი სიტყვების გარეშე" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding CleanNames, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionTitle}" Margin="2,14,0,4" Text="ერთდროულად ჩამოიტვირთოს" />
                            <ListBox Style="{StaticResource ChipList}" Margin="0,6,0,0"
                                     ItemsSource="{Binding ParallelOptions}"
                                     SelectedItem="{Binding MaxParallel, Mode=TwoWay}" />

                            <TextBlock Style="{StaticResource SectionTitle}" Margin="2,14,0,4" Text="Cookies ბრაუზერიდან" />
                            <TextBlock Margin="2,0,0,8" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                                       Text="დახურული ან 18+ ვიდეოებისთვის (Facebook, Instagram, YouTube). Firefox ყველაზე საიმედოა" />
                            <ListBox Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding CookieBrowsers}" DisplayMemberPath="Name"
                                     SelectedItem="{Binding SelectedCookie, Mode=TwoWay}" />

                            <Border Height="8" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- move finished file to another component -->
        <Popup x:Name="MovePopup" StaysOpen="False" AllowsTransparency="True" Placement="MousePoint"
               PopupAnimation="Fade">
            <Border Margin="12" Width="270" CornerRadius="16" Padding="8" Background="#F2121228"
                    BorderBrush="#26FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="10,8,0,6" Text="გადატანა კომპონენტში" />
                    <ListBox x:Name="MoveList" Style="{StaticResource FlatListBox}" MaxHeight="260"
                             ItemsSource="{Binding Groups}"
                             ItemContainerStyle="{StaticResource TargetItem}"
                             SelectionChanged="MoveList_SelectionChanged" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>