<UserControl x:Class="SoundPanel.Controls.SoundFxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="2,0,0,10" />
        </Style>

        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="PlainListBox" TargetType="ListBox">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- preset chip -->
        <Style x:Key="PresetChip" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12" Padding="14,7" Margin="0,0,8,8"
                                Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="13" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- animated switch -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border CornerRadius="13" Background="#26FFFFFF" />
                            <Border x:Name="On" CornerRadius="13" Background="{DynamicResource AccentBrushH}" Opacity="0" />
                            <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobTr" X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetName="KnobTr" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetName="KnobTr" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- slider parts -->
        <Style x:Key="FxThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="{DynamicResource AccentBrushH}" StrokeThickness="3">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FxFillH" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FxFillV" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Width="4" CornerRadius="2" HorizontalAlignment="Center"
                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FxFillNone" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="FxSliderH" TargetType="Slider">
            <Grid Height="24" Background="Transparent">
                <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center" />
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource FxFillH}" Command="Slider.DecreaseLarge" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource FxThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource FxFillNone}" Command="Slider.IncreaseLarge" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="FxSliderV" TargetType="Slider">
            <Grid Width="24" Background="Transparent">
                <Border Width="4" CornerRadius="2" Background="#26FFFFFF" HorizontalAlignment="Center" />
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource FxFillV}" Command="Slider.DecreaseLarge" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource FxThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource FxFillNone}" Command="Slider.IncreaseLarge" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style x:Key="FxSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template" Value="{StaticResource FxSliderH}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Template" Value="{StaticResource FxSliderV}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Surface" CornerRadius="24" Opacity="0"
            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SurfaceTr" Y="14" />
        </Border.RenderTransform>

        <Grid Margin="26,22,16,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="0,0,10,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="30" FontWeight="Bold" Text="ხმის დამუშავება"
                               Foreground="{DynamicResource AccentBrushH}" />
                    <TextBlock Margin="2,2,0,0" FontSize="13" Foreground="{StaticResource TextSecondary}"
                               Text="ეკვალაიზერი, ეფექტები და ხმის გასწორება რეალურ დროში" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="ორიგინალი" Margin="0,0,8,0"
                            ToolTip="დააჭირე და გეჭიროს: გაიგონებ დაუმუშავებელ ხმას. გაუშვი და დამუშავებული დაბრუნდება"
                            PreviewMouseLeftButtonDown="Bypass_Down" PreviewMouseLeftButtonUp="Bypass_Up"
                            LostMouseCapture="Bypass_Lost" />
                    <Button Style="{StaticResource GhostButton}" Content="განულება" Margin="0,0,18,0"
                            Click="Reset_Click" />
                    <TextBlock Style="{StaticResource RowLabel}" Margin="0,0,10,0" Text="ჩართულია" />
                    <ToggleButton Style="{StaticResource SwitchStyle}" IsChecked="{Binding Fx.Enabled, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Fx.Enabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- PRESETS -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="პრესეტები" />
                    <ListBox Style="{StaticResource PlainListBox}" Margin="0,0,0,10"
                             ItemsSource="{Binding Fx.Presets}"
                             SelectedValuePath="Name" SelectedValue="{Binding Fx.PresetName, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PresetChip}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrushH}"
                                               ToolTip="შენი პრესეტი"
                                               Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- preset actions -->
                    <WrapPanel Margin="0,0,0,10">
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12" Margin="0,0,8,6"
                                Content="+ შენახვა" ToolTip="მიმდინარე ხმის შენახვა პრესეტად" Click="SaveNew_Click" />
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12" Margin="0,0,8,6"
                                Content="წაშლა" Click="DeletePreset_Click"
                                Visibility="{Binding Fx.IsUserPreset, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12" Margin="0,0,8,6"
                                Content="ექსპორტი" ToolTip="შენი პრესეტების ფაილში შენახვა" Click="ExportPresets_Click" />
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12" Margin="0,0,0,6"
                                Content="იმპორტი" ToolTip="პრესეტების ფაილიდან დამატება" Click="ImportPresets_Click" />
                    </WrapPanel>

                    <!-- naming -->
                    <Border Margin="0,0,0,14" CornerRadius="14" Padding="12" Background="#0FFFFFFF"
                            BorderBrush="#1AFFFFFF" BorderThickness="1"
                            Visibility="{Binding Fx.IsNaming, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,8" Text="პრესეტის სახელი" />
                            <TextBox x:Name="PresetNameBox" Style="{StaticResource DialogTextBox}" FontSize="13" MaxLength="30"
                                     Text="{Binding Fx.NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="PresetNameBox_KeyDown" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource AccentButton}" Padding="18,7" FontSize="12"
                                        Content="შენახვა" Click="ConfirmSave_Click" />
                                <Button Style="{StaticResource GhostButton}" Padding="14,7" FontSize="12" Margin="8,0,0,0"
                                        Content="გაუქმება" Click="CancelName_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- EQUALIZER -->
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="2,8,0,10" Text="ეკვალაიზერი (10 ზოლი)" />
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <Grid x:Name="CurveHost" Height="130" Margin="0,0,0,14" ClipToBounds="True"
                                  SizeChanged="Curve_SizeChanged">
                                <Border CornerRadius="12" Background="#0AFFFFFF" />
                                <Path x:Name="CurveGrid" Stroke="#1FFFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                                <Path x:Name="CurveFill" Fill="{DynamicResource AccentSoftBrush}" IsHitTestVisible="False" />
                                <Path x:Name="CurveLine" Stroke="{DynamicResource AccentBrushH}" StrokeThickness="2"
                                      StrokeLineJoin="Round" IsHitTestVisible="False" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Fx.Bands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding GainText}" HorizontalAlignment="Center" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                                            <Slider Style="{StaticResource FxSlider}" Orientation="Vertical" Height="150"
                                                    HorizontalAlignment="Center" Minimum="-12" Maximum="12"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                    Value="{Binding Gain, Mode=TwoWay}"
                                                    Uid="0" MouseDoubleClick="Slider_Reset"
                                                    ToolTip="ორმაგი დაწკაპუნება — განულება" />
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11"
                                                       Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- TONE -->
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="2,18,0,10" Text="ტონი და სიმაღლე" />
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="ხმის გაძლიერება" />
                                <Slider Grid.Column="1" Margin="10,0" Style="{StaticResource FxSlider}"
                                        Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding Fx.Preamp, Mode=TwoWay}" Uid="0" MouseDoubleClick="Slider_Reset" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}"
                                           Text="{Binding Fx.Preamp, StringFormat={}{0:+0.#;-0.#;0} dB}" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Bass" />
                                <Slider Grid.Column="1" Margin="10,0" Style="{StaticResource FxSlider}"
                                        Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding Fx.Bass, Mode=TwoWay}" Uid="0" MouseDoubleClick="Slider_Reset" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}"
                                           Text="{Binding Fx.Bass, StringFormat={}{0:+0.#;-0.#;0} dB}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Treble" />
                                <Slider Grid.Column="1" Margin="10,0" Style="{StaticResource FxSlider}"
                                        Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding Fx.Treble, Mode=TwoWay}" Uid="0" MouseDoubleClick="Slider_Reset" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}"
                                           Text="{Binding Fx.Treble, StringFormat={}{0:+0.#;-0.#;0} dB}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DYNAMICS -->
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="2,18,0,10" Text="დინამიკა" />
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowLabel}" Text="ნორმალიზაცია" />
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                           Text="სიმღერების სიმაღლე ერთმანეთს გაუთანაბრდება" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding Fx.Normalize, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="სიმაღლის მიზანი (LUFS)" />
                            <TextBlock Margin="0,2,0,10" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       Text="ნორმალიზაცია ხმას ამ დონემდე მიიყვანს. ტელევიზიისთვის −23 (EBU R128)" />
                            <ListBox Style="{StaticResource PlainListBox}"
                                     ItemsSource="{Binding Fx.Targets}"
                                     SelectedValuePath="Value" SelectedValue="{Binding Fx.TargetLufs, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource PresetChip}" DisplayMemberPath="Name">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Limiter" />
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                           Text="იცავს ხმას დამახინჯებისგან, როცა EQ ან გაძლიერება ზედმეტია" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding Fx.Limiter, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- EFFECTS -->
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="2,18,0,10" Text="ეფექტები" />
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="სტერეოს სიგანე" />
                                <Slider Grid.Column="1" Margin="10,0" Style="{StaticResource FxSlider}"
                                        Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Tag="{DynamicResource AccentBrushH}"
                                        Value="{Binding Fx.Width, Mode=TwoWay}" Uid="100" MouseDoubleClick="Slider_Reset" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}"
                                           Text="{Binding Fx.Width, StringFormat={}{0:0}%}" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="ექო" />
                                <Slider Grid.Column="1" Margin="10,0" Style="{StaticResource FxSlider}"
                                        Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Tag="{DynamicResource AccentBrushH}"
                                        Value="{Binding Fx.Echo, Mode=TwoWay}" Uid="0" MouseDoubleClick="Slider_Reset" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}"
                                           Text="{Binding Fx.Echo, StringFormat={}{0:0}%}" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Foreground="{StaticResource TextSecondary}" Text="ექოს დაყოვნება" />
                                <Slider Grid.Column="1" Margin="10,0" Style="{StaticResource FxSlider}"
                                        Minimum="100" Maximum="800" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Tag="{DynamicResource AccentBrushH}"
                                        Value="{Binding Fx.EchoMs, Mode=TwoWay}" Uid="320" MouseDoubleClick="Slider_Reset" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}"
                                           Text="{Binding Fx.EchoMs, StringFormat={}{0:0} ms}" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="რევერბი" />
                                <Slider Grid.Column="1" Margin="10,0" Style="{StaticResource FxSlider}"
                                        Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Tag="{DynamicResource AccentBrushH}"
                                        Value="{Binding Fx.Reverb, Mode=TwoWay}" Uid="0" MouseDoubleClick="Slider_Reset" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}"
                                           Text="{Binding Fx.Reverb, StringFormat={}{0:0}%}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Foreground="{StaticResource TextSecondary}" Text="ოთახის ზომა" />
                                <Slider Grid.Column="1" Margin="10,0" Style="{StaticResource FxSlider}"
                                        Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Tag="{DynamicResource AccentBrushH}"
                                        Value="{Binding Fx.ReverbSize, Mode=TwoWay}" Uid="50" MouseDoubleClick="Slider_Reset" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}"
                                           Text="{Binding Fx.ReverbSize, StringFormat={}{0:0}%}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="4,8,0,4" FontSize="11" Foreground="{StaticResource TextMuted}"
                               Text="ცვლილება მაშინვე ისმის. სლაიდერზე ორმაგი დაწკაპუნება მნიშვნელობას საწყისზე აბრუნებს." />
                </StackPanel>
            </ScrollViewer>

            <!-- LEVEL METERS (always visible) -->
            <Border Grid.Row="2" Margin="0,12,10,0" CornerRadius="16" Padding="16,12"
                    Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid x:Name="HostL" Height="10">
                            <Border CornerRadius="5" Background="#14FFFFFF" />
                            <Border x:Name="BarL" CornerRadius="5" HorizontalAlignment="Left" Width="0"
                                    Background="{DynamicResource AccentBrushH}" />
                            <Border x:Name="HoldL" Width="2" HorizontalAlignment="Left" Background="White" Opacity="0.85" />
                        </Grid>
                        <Grid x:Name="HostR" Height="10" Margin="0,6,0,0">
                            <Border CornerRadius="5" Background="#14FFFFFF" />
                            <Border x:Name="BarR" CornerRadius="5" HorizontalAlignment="Left" Width="0"
                                    Background="{DynamicResource AccentBrushH}" />
                            <Border x:Name="HoldR" Width="2" HorizontalAlignment="Left" Background="White" Opacity="0.85" />
                        </Grid>
                        <TextBlock x:Name="LevelText" Margin="0,8,0,0" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" Text="Peak —    RMS —" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel MinWidth="56" Margin="12,0,0,0" ToolTip="მომენტალური (0.4 წმ)">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="LUFS · M" />
                            <TextBlock x:Name="LufsMText" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Text="—" />
                        </StackPanel>
                        <StackPanel MinWidth="56" Margin="12,0,0,0" ToolTip="მოკლე (3 წმ)">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="LUFS · S" />
                            <TextBlock x:Name="LufsSText" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Text="—" />
                        </StackPanel>
                        <StackPanel MinWidth="56" Margin="12,0,0,0"
                                    ToolTip="მთელი ტრეკის საშუალო. მწვანე: მიზნიდან ±1, ყვითელი ±3">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="LUFS · I" />
                            <TextBlock x:Name="LufsIText" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Text="—" />
                        </StackPanel>
                        <StackPanel MinWidth="56" Margin="12,0,0,0" ToolTip="Limiter რამდენით აწევს ხმას დაბლა">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="LIMITER" />
                            <TextBlock x:Name="GrText" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Text="0.0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>