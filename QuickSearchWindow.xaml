<Window x:Class="SoundPanel.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoundPanel.Controls"
        Title="Fifu" Width="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI, Sylfaen"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="HitItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="14" Padding="10,8" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HitTemplate">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Border CornerRadius="11" Background="#14FFFFFF" />
                    <Path Data="{StaticResource IconNote}" Fill="{StaticResource TextSecondary}"
                          Width="16" Height="16" Stretch="Uniform" />
                    <Border CornerRadius="11">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimary}"
                               ctl:Highlight.Text="{Binding Title}"
                               ctl:Highlight.Query="{Binding Query}" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMuted}" Text="{Binding Folder}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28">
        <Border x:Name="Card" CornerRadius="26" Background="#F2121228" Opacity="0"
                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96" />
                    <TranslateTransform x:Name="CardTr" Y="-10" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource AccentColorA}" BlurRadius="36" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>

            <StackPanel>
                <!-- search row -->
                <Grid Height="76" Margin="20,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ctl:RobotFace x:Name="Fifu" Width="46" Height="46" VerticalAlignment="Center" IsHitTestVisible="False" />

                    <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBox x:Name="Box" FontSize="20" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource TextPrimary}" CaretBrush="White" Padding="0"
                                 VerticalContentAlignment="Center" Margin="0,0,46,0" TextChanged="Box_TextChanged" />
                        <Button x:Name="MicButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="38" Height="38" Style="{StaticResource IconButton}"
                                ToolTip="ხმოვანი ბრძანება (Ctrl+M)" Click="MicButton_Click">
                            <Path Data="M12,3 A3,3 0 0 1 15,6 V11 A3,3 0 0 1 9,11 V6 A3,3 0 0 1 12,3 Z M5.5,11 A6.5,6.5 0 0 0 18.5,11 M12,17.5 V21 M8.5,21 H15.5"
                                  Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.7" Width="18" Height="18"
                                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Text="რა დავუკრა?" />
                    </Grid>
                </Grid>

                <Border x:Name="Divider" Height="1" Margin="20,0" Background="#1AFFFFFF" Visibility="Collapsed" />

                <!-- results -->
                <ListBox x:Name="List" Style="{StaticResource FlatListBox}" Margin="12,10,12,4"
                         ItemContainerStyle="{StaticResource HitItem}"
                         ItemTemplate="{StaticResource HitTemplate}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Visibility="Collapsed"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" />

                <TextBlock x:Name="Hint" Margin="22,8,22,16" FontSize="11" Foreground="{StaticResource TextMuted}"
                           Text="↑ ↓ არჩევა   ·   Enter დაკვრა   ·   Esc დახურვა" />
            </StackPanel>
        </Border>
    </Grid>
</Window>