<Window x:Class="SoundPanel.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, Sylfaen"
        Foreground="{StaticResource TextPrimary}"
        Loaded="Window_Loaded">

    <Border x:Name="Card" Margin="28" CornerRadius="26" Padding="28" BorderThickness="1"
            Background="#FF14142A" BorderBrush="#2AFFFFFF"
            MouseLeftButtonDown="Card_MouseLeftButtonDown"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.92" ScaleY="0.92" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource AccentColorA}" BlurRadius="50" ShadowDepth="0" Opacity="0.35" />
        </Border.Effect>

        <StackPanel>
            <Border Width="48" Height="48" CornerRadius="15" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}">
                <Path Data="{StaticResource IconFolder}" Fill="White" Width="22" Height="22" Stretch="Uniform" />
            </Border>

            <TextBlock Margin="0,18,0,4" FontSize="22" FontWeight="Bold" Text="ახალი კომპონენტი" />
            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                       Text="ამავე სახელის ფოლდერი შეიქმნება მთავარ საქაღალდეში." />

            <TextBox x:Name="NameBox" Margin="0,20,0,0" Style="{StaticResource DialogTextBox}" MaxLength="80" />

            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="გაუქმება" IsCancel="True" Click="Cancel_Click" />
                <Button Margin="10,0,0,0" Style="{StaticResource AccentButton}" Content="შექმნა" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
