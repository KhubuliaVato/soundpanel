<Window x:Class="SoundPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:SoundPanel.Controls"
        Title="1Flow SoundPanel"
        Icon="app.ico"
        Width="1200" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowDrop="True"
        Background="#090912"
        FontFamily="Segoe UI Variable Text, Segoe UI, Sylfaen"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- sidebar page button (Downloads / Settings) -->
        <Style x:Key="NavItem" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="14" Padding="6" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Play / pause icon switches with state -->
        <Style x:Key="PlayPauseIcon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconPlay}" />
            <Setter Property="Fill" Value="White" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Stretch" Value="Uniform" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Data" Value="{StaticResource IconPause}" />
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Folder / library icon for sidebar items -->
        <Style x:Key="GroupIcon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconFolder}" />
            <Setter Property="Fill" Value="{StaticResource TextSecondary}" />
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Stretch" Value="Uniform" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAll}" Value="True">
                    <Setter Property="Data" Value="{StaticResource IconLibrary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="GroupTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="#14FFFFFF">
                    <Path Style="{StaticResource GroupIcon}" />
                </Border>
                <TextBlock Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" FontSize="14"
                           FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="9" Padding="8,2" Background="#14FFFFFF">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Text="{Binding Count}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TrackTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBox" Width="40" Height="40" CornerRadius="12" Background="#14FFFFFF">
                    <Grid>
                        <Path x:Name="NoteIcon" Data="{StaticResource IconNote}" Fill="{StaticResource TextSecondary}"
                              Width="17" Height="17" Stretch="Uniform" />
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCover}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel x:Name="Eq" Orientation="Horizontal" Height="16" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Rectangle x:Name="Bar1" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.4" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar2" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.4" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar3" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.4" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Title" FontSize="15" FontWeight="SemiBold"
                               ctl:Highlight.Text="{Binding Title}"
                               ctl:Highlight.Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding Extension}"
                               Foreground="{StaticResource TextMuted}" />
                </StackPanel>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" Margin="8,0,4,0"
                           Foreground="{StaticResource TextSecondary}" Text="{Binding DurationText}" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="IconBox" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="NoteIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Eq" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="EqStory">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.3" To="1" Duration="0:0:0.42" DecelerationRatio="0.6" />
                                <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.5" To="1" Duration="0:0:0.57" DecelerationRatio="0.6" />
                                <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.25" To="0.9" Duration="0:0:0.48" DecelerationRatio="0.6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="EqStory" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource WindowBackground}" ClipToBounds="True">

        <!-- ============ AMBIENT GLOWS ============ -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="680" Height="680" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-260,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource AmbA1}" Offset="0" />
                        <GradientStop Color="{DynamicResource AmbA0}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform />
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="160" Duration="0:0:11" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="110" Duration="0:0:14" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-300">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource AmbB1}" Offset="0" />
                        <GradientStop Color="{DynamicResource AmbB0}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform />
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-170" Duration="0:0:13" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-120" Duration="0:0:10" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="420" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="260,40,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop 	Color="{DynamicResource AmbC1}" Offset="0" />
                        <GradientStop 	Color="{DynamicResource AmbC0}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ TITLE BAR ============ -->
            <Grid Grid.Row="0" Margin="20,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                        <Path Data="{StaticResource IconNote}" Fill="White" Width="15" Height="15" Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold">
                        <Run Text="1Flow" />
                        <Run Text="SoundPanel" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click">
                        <Path Data="{StaticResource IconMinimize}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                              Width="12" Height="12" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click">
                        <Path Data="{StaticResource IconMaximize}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                              Width="11" Height="11" Stretch="Uniform" StrokeLineJoin="Round" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click">
                        <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                              Width="12" Height="12" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ CONTENT ============ -->
            <Grid Grid.Row="1" Margin="16,4,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- PAGES (open over the library; the library hides while one is open) -->
                <ctl:SettingsPanel x:Name="SettingsPane" Grid.Column="2" Panel.ZIndex="5" />
                <ctl:DownloadPanel x:Name="DownloadPane" Grid.Column="2" Panel.ZIndex="5" />
                <ctl:SoundFxPanel x:Name="FxPane" Grid.Column="2" Panel.ZIndex="5" />

                <!-- SIDEBAR -->
                <Border Grid.Column="0" CornerRadius="24" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="6,4,2,12">
                                                       <!-- component search: a small button that expands into a field -->
                            <Border x:Name="GroupSearchHost" Panel.ZIndex="3" HorizontalAlignment="Right" Margin="0,0,42,0"
                                    Width="36" Height="36" CornerRadius="12" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="Open">
                                                <Setter Property="Background" Value="#18FFFFFF" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Width="34" Height="34" Style="{StaticResource IconButton}"
                                            ToolTip="კომპონენტების ძებნა" Click="GroupSearchToggle_Click">
                                        <Grid Width="16" Height="16">
                                            <Path Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M16.5,16.5 L21,21"
                                                  Stroke="{StaticResource TextSecondary}" StrokeThickness="1.9" Stretch="Uniform"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Ellipse x:Name="GroupSearchDot" Width="8" Height="8" Margin="0,-5,-5,0"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Grid x:Name="GroupSearchField" Grid.Column="1" Opacity="0" IsHitTestVisible="False" Margin="2,0,0,0">
                                        <TextBox x:Name="GroupSearchBox" BorderThickness="0" Background="Transparent" Padding="0"
                                                 FontSize="13" Foreground="{StaticResource TextPrimary}"
                                                 CaretBrush="White" VerticalAlignment="Center"
                                                 TextChanged="GroupSearchBox_TextChanged"
                                                 PreviewKeyDown="GroupSearchBox_PreviewKeyDown" />
                                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{StaticResource TextMuted}" Text="კომპონენტი…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=GroupSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Button x:Name="GroupSearchClear" Grid.Column="2" Width="28" Height="28"
                                            Style="{StaticResource IconButton}" Visibility="Collapsed"
                                            Click="GroupSearchClear_Click" ToolTip="გასუფთავება (Esc)">
                                        <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                              Width="9" Height="9" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="GroupsTitle" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="კომპონენტები"
                                       Foreground="{StaticResource TextSecondary}" />
                            <Button HorizontalAlignment="Right" Width="36" Height="36" Style="{StaticResource IconButton}"
                                    ToolTip="ახალი კომპონენტი" Click="AddGroup_Click"
                                    IsEnabled="{Binding HasRoot}">
                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                                    <Path Data="{StaticResource IconPlus}" Fill="White" Width="14" Height="14" Stretch="Uniform" />
                                </Border>
                            </Button>
                        </Grid>

                        <ListBox x:Name="GroupsList" Grid.Row="1" Style="{StaticResource FlatListBox}"
                                 ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource GroupItemStyle}"
                                 ItemTemplate="{StaticResource GroupTemplate}"
                                 AllowDrop="True"
                                 DragOver="GroupsList_DragOver"
                                 Drop="GroupsList_Drop" />

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <ToggleButton x:Name="NavDownloads" Style="{StaticResource NavItem}" Click="NavDownloads_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#14FFFFFF">
                                        <Path Data="M12,4 V15 M7,10.5 L12,15.5 L17,10.5 M5,19.5 H19"
                                              Stroke="{StaticResource TextSecondary}" StrokeThickness="1.7" Width="16" Height="16"
                                              Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" FontSize="14"
                                               FontWeight="SemiBold" Text="გადმოწერები" />
                                    <Border x:Name="DownloadBadgeBox" Grid.Column="2" VerticalAlignment="Center" CornerRadius="9"
                                            Padding="8,2" Margin="0,0,4,0" Visibility="Collapsed"
                                            Background="{DynamicResource AccentBrush}">
                                        <TextBlock x:Name="DownloadBadge" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="NavFx" Style="{StaticResource NavItem}" Click="NavFx_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#14FFFFFF">
                                        <Path Data="M4,9 V15 M8,6 V18 M12,3 V21 M16,7 V17 M20,10 V14"
                                              Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Width="16" Height="16"
                                              Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" FontSize="14"
                                               FontWeight="SemiBold" Text="ხმის დამუშავება" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="NavSettings" Style="{StaticResource NavItem}" Click="NavSettings_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#14FFFFFF">
                                        <Path Data="M3,6 H11 M17,6 H21 M14,3.8 A2.2,2.2 0 1 0 14,8.2 A2.2,2.2 0 1 0 14,3.8 Z M3,12 H5 M11,12 H21 M8,9.8 A2.2,2.2 0 1 0 8,14.2 A2.2,2.2 0 1 0 8,9.8 Z M3,18 H13 M19,18 H21 M16,15.8 A2.2,2.2 0 1 0 16,20.2 A2.2,2.2 0 1 0 16,15.8 Z"
                                              Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6" Width="16" Height="16"
                                              Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" FontSize="14"
                                               FontWeight="SemiBold" Text="პარამეტრები" />
                                </Grid>
                            </ToggleButton>
                        </StackPanel>

                       
                    </Grid>
                </Border>

                <!-- MAIN PANEL -->
                <Border x:Name="LibraryPage" Grid.Column="2" CornerRadius="24" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <Grid Margin="24,22,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,10,16">
                            <StackPanel>
                                <TextBlock FontSize="30" FontWeight="Bold" Text="{Binding SelectedGroup.Name}"
                                           Foreground="{DynamicResource AccentBrushH}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="2,2,0,0" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                           Text="{Binding TracksSubtitle}" />
                            </StackPanel>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}">
                                <Border HorizontalAlignment="Right" Height="40" CornerRadius="14" Padding="13,0,6,0" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Width" Value="230" />
                                            <Setter Property="Background" Value="#0FFFFFFF" />
                                            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="Background" Value="#18FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="{DynamicResource AccentColorA}" BlurRadius="22" ShadowDepth="0" Opacity="0.35" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="320" Duration="0:0:0.28">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="230" Duration="0:0:0.28">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Path Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M16.5,16.5 L21,21"
                                              Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Width="15" Height="15"
                                              Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                        <Grid Grid.Column="1" Margin="10,0,4,0">
                                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="0"
                                                     FontSize="13" Foreground="{StaticResource TextPrimary}"
                                                     CaretBrush="White" VerticalContentAlignment="Center"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
                                            <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" Text="ძებნა…   Ctrl+F">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <Button Grid.Column="2" Width="28" Height="28" Style="{StaticResource IconButton}"
                                                Click="SearchClear_Click" ToolTip="გასუფთავება (Esc)"
                                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}">
                                            <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                                  Width="9" Height="9" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,6,4,0" HorizontalAlignment="Right" FontSize="11"
                                           Foreground="{StaticResource TextMuted}" Text="გადაათრიე სიმღერა კომპონენტზე" />
                            </StackPanel>
                            
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="TracksList" Style="{StaticResource FlatListBox}"
                                     ItemsSource="{Binding Tracks}"
                                     ItemContainerStyle="{StaticResource TrackItemStyle}"
                                     ItemTemplate="{StaticResource TrackTemplate}"
                                     SelectionMode="Single" AllowDrop="True"
                                     Padding="0,0,10,0"
                                     PreviewMouseLeftButtonDown="TracksList_PreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="TracksList_PreviewMouseLeftButtonUp"
                                     PreviewMouseMove="TracksList_PreviewMouseMove"
                                     MouseDoubleClick="TracksList_MouseDoubleClick"
                                     DragOver="TracksList_DragOver"
                                     Drop="TracksList_Drop" />

                            <!-- empty state: no folder chosen -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ShowNoRoot, Converter={StaticResource BoolToVis}}">
                                <Border Width="92" Height="92" CornerRadius="28" Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource AccentColorA}" BlurRadius="40" ShadowDepth="0" Opacity="0.55" />
                                    </Border.Effect>
                                    <Path Data="{StaticResource IconNote}" Fill="White" Width="40" Height="40" Stretch="Uniform" />
                                </Border>
                                <TextBlock Margin="0,22,0,6" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"
                                           Text="აირჩიე საქაღალდე მუსიკით" />
                                <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                           Text="სიმღერები აქ ავტომატურად ჩამოლაგდება" />
                                <Button Margin="0,22,0,0" HorizontalAlignment="Center" Style="{StaticResource AccentButton}"
                                        Content="საქაღალდის არჩევა" Click="ChooseFolder_Click" />
                            </StackPanel>

                            <!-- empty: nothing matches the search -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVis}}">
                                <Path Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M16.5,16.5 L21,21"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.4" Width="44" Height="44"
                                      Stretch="Uniform" HorizontalAlignment="Center"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           Text="{Binding SearchText, StringFormat=„{0}“ ვერ მოიძებნა}" />
                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextMuted}" Text="სცადე სხვა სიტყვა" />
                            </StackPanel>

                            <!-- empty: folder has no tracks -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ShowEmptyTracks, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource IconNote}" Fill="{StaticResource TextMuted}" Width="44" Height="44"
                                      Stretch="Uniform" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}" Text="აქ ჯერ სიმღერა არ არის" />
                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextMuted}" Text="გადმოათრიე ფაილები ან დაამატე მთავარი გვერდიდან" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ PLAYER BAR ============ -->
            <Border Grid.Row="2" Margin="16" CornerRadius="24" Padding="20,14"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <!-- now playing -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ctl:RobotFace x:Name="FifuRobot" Width="62" Height="62" Margin="-4,0,0,0" ToolTip="Fifu"
                                       IsPlaying="{Binding IsPlaying, Mode=OneWay}"
                                       Peaks="{Binding Peaks, Mode=OneWay}"
                                       Position="{Binding PositionSeconds, Mode=OneWay}"
                                       Duration="{Binding DurationSeconds, Mode=OneWay}" />
                        <Border Width="52" Height="52" CornerRadius="14" Margin="14,0,0,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CurrentCover}" Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCover}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="140">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding NowPlayingTitle}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding NowPlayingTitle}" />
                            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource TextMuted}" Text="1Flow SoundPanel" />
                        </StackPanel>
                    </StackPanel>

                    <!-- transport + seek -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ToggleButton Margin="0,0,8,0" Style="{StaticResource ToggleIconButton}"
                                          IsChecked="{Binding Shuffle, Mode=TwoWay}" ToolTip="არეულად დაკვრა">
                                <Path Data="{StaticResource IconShuffle}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </ToggleButton>
                            <Button Style="{StaticResource IconButton}" Click="Prev_Click">
                                <Path Data="{StaticResource IconPrev}" Fill="{StaticResource TextPrimary}" Width="20" Height="20" Stretch="Uniform" />
                            </Button>
                            <Button Margin="14,0" Style="{StaticResource PlayButton}" Click="PlayPause_Click">
                                <Path Style="{StaticResource PlayPauseIcon}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="Next_Click">
                                <Path Data="{StaticResource IconNext}" Fill="{StaticResource TextPrimary}" Width="20" Height="20" Stretch="Uniform" />
                            </Button>
                            <ToggleButton Margin="8,0,0,0" Style="{StaticResource ToggleIconButton}"
                                          IsChecked="{Binding Repeat, Mode=TwoWay}" ToolTip="სიის გამეორება (მუსიკა არ გაჩერდება)">
                                <Path Data="{StaticResource IconRepeat}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </ToggleButton>
                        </StackPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                       Text="{Binding PositionText}" />
                            <ctl:WaveformSeekBar x:Name="Waveform" Grid.Column="1" Height="44"
                                                 Peaks="{Binding Peaks}"
                                                 Duration="{Binding DurationSeconds}"
                                                 Position="{Binding PositionSeconds, Mode=OneWay}"
                                                 SeekStarted="Waveform_SeekStarted"
                                                 SeekPreview="Waveform_SeekPreview"
                                                 SeekCommitted="Waveform_SeekCommitted" />
                            <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding DurationText}" />
                        </Grid>
                    </StackPanel>

                    <!-- volume -->
                    <ctl:VolumeKnob Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Value="{Binding Volume, Mode=TwoWay}" Clicked="VolumeKnob_Clicked" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============ TOAST ============ -->

        <!-- Fifu's speech bubble (replaces the old toast) -->
        <StackPanel x:Name="Toast" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,100"
                    Opacity="0" IsHitTestVisible="False">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="ToastTr" Y="12" />
            </StackPanel.RenderTransform>
            <Border CornerRadius="16" Padding="16,10" MaxWidth="340" Background="#F0181830"
                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource AccentColorA}" BlurRadius="30" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <TextBlock x:Name="ToastText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <Path Data="M0,0 L16,0 L7,10 Z" Fill="#F0181830" HorizontalAlignment="Left" Margin="30,-1,0,0" />
        </StackPanel>

        <!-- Fifu offers to download a copied link -->
        <StackPanel x:Name="Offer" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,100"
                    Opacity="0" Visibility="Collapsed">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="OfferTr" Y="12" />
            </StackPanel.RenderTransform>
            <Border CornerRadius="16" Padding="16,12" MaxWidth="340" Background="#F0181830"
                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource AccentColorA}" BlurRadius="30" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="ბმული ვნახე! გადმოვწერო?" />
                    <TextBlock x:Name="OfferLink" Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMuted}" MaxWidth="300" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="კი, გადავწეროთ" Click="OfferYes_Click" />
                        <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="არა" Click="OfferNo_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Path Data="M0,0 L16,0 L7,10 Z" Fill="#F0181830" HorizontalAlignment="Left" Margin="30,-1,0,0" />
        </StackPanel>

               <!-- Fifu's settings are built here and moved into Settings > Fifu at startup (MainWindow.Pages.cs) -->
        <Grid x:Name="FifuStash" Visibility="Collapsed">
            <StackPanel x:Name="FifuSettings">
                <TextBlock Style="{DynamicResource SectionTitle}" Margin="2,0,0,10" Text="ხმოვანი ბრძანებები" />

                <Border Style="{DynamicResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                       Text="ხმოვანი ბრძანება" />
                            <TextBlock Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                                       Text="Ctrl+M. თქვი ინგლისურად: play სახელი · next · previous · stop · shuffle on/off · repeat on/off · volume 120" />
                        </StackPanel>
                        <Button Grid.Column="1" Padding="20,9" Style="{StaticResource AccentButton}" Content="მოსმენა"
                                Click="VoiceButton_Click" />
                    </Grid>
                </Border>

                <Border Style="{DynamicResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                       Text="ხმით გააქტიურება" />
                            <TextBlock Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                                       Text="თქვი „Fifu“ და მერე ბრძანება. მუშაობს ჩაკეცილ პროგრამაზეც" />
                        </StackPanel>
                        <ToggleButton x:Name="HandsFreeCheck" Grid.Column="1" Style="{DynamicResource SwitchStyle}"
                                      Click="HandsFreeCheck_Click" />
                    </Grid>
                </Border>

                <TextBlock Style="{DynamicResource SectionTitle}" Margin="2,18,0,10" Text="მიკროფონი" />
                <Border Style="{DynamicResource SettingRow}" Padding="10,8">
                    <ListBox x:Name="MicCombo" Style="{DynamicResource PlainListBox}"
                             ItemContainerStyle="{DynamicResource DeviceItem}"
                             Loaded="MicCombo_Loaded" SelectionChanged="MicCombo_SelectionChanged" />
                </Border>

                <TextBlock Style="{DynamicResource SectionTitle}" Margin="2,18,0,10" Text="ძილის ტაიმერი" />
                <Border Style="{DynamicResource SettingRow}">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   Text="მუსიკა ჩაჩუმდება და გაჩერდება" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   Text="ბოლო 20 წამში ხმა თანდათან მცირდება" />
                        <UniformGrid Rows="1" Margin="0,12,0,0">
                            <Button Margin="0,0,6,0" Padding="0,9" Style="{StaticResource GhostButton}" Content="5 წთ" Tag="5" Click="SleepPreset_Click" />
                            <Button Margin="0,0,6,0" Padding="0,9" Style="{StaticResource GhostButton}" Content="15 წთ" Tag="15" Click="SleepPreset_Click" />
                            <Button Margin="0,0,6,0" Padding="0,9" Style="{StaticResource GhostButton}" Content="30 წთ" Tag="30" Click="SleepPreset_Click" />
                            <Button Padding="0,9" Style="{StaticResource GhostButton}" Content="60 წთ" Tag="60" Click="SleepPreset_Click" />
                        </UniformGrid>
                        <StackPanel x:Name="FifuSleepActive" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="FifuSleepInfo" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Padding="16,8"
                                    Style="{StaticResource GhostButton}" Content="ტაიმერის გაუქმება"
                                    Click="SleepCancel_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
